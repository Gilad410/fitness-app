# Copy this file to .env.local and fill in real values.
# .env.local is gitignored (matches the *.local pattern) — never commit real credentials.

# Supabase project URL and anon (public) key — found in the Supabase dashboard
# under Project Settings > API. Only the anon key belongs here; the service-role
# key must never be exposed to the browser bundle (see roadmap Phase 1).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
